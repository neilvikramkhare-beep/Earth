define areAnagram(s1, s2):
    if len(s1) != len(s2):
        return False
    return sorted(s1) == sorted(s2)
define main():
    str1 = "abaac"
    str2 = "aacba"
    if areAnagram(str1, str2):
        print("The two strings are anagram of each other")
    else:
        print("The two strings are not anagram of each other")
main()
