define power(base, exp, mod):
    res = 1
    base = base % mod
    while exp > 0:
        if exp % 2 == 1:
            res = (res * base) % mod
        base = (base * base) % mod
        exp = exp // 2
    return res
print("--- Diffie-Hellman Man-in-the-Middle Simulation ---\n")
P = 23
G = 5
print(f"Publicly shared Prime (P): {P}")
print(f"Publicly shared Generator (G): {G}\n")
a = 6
A = power(G, a, P)
print(f"Alice's Private Key (a): {a}")
print(f"Alice sends her Public Key (A) = {A} to Bob...")
print("\n[!] EVE INTERCEPTS ALICE'S KEY [!]")
eve_private_alice = 10
Eve_public_alice = power(G, eve_private_alice, P)
print(f"Eve generates her Private Key for Alice: {eve_private_alice}")
print(f"Eve sends HER Public Key = {Eve_public_alice} to Bob, pretending to be Alice.\n")
# 3. Bob generates his keys
