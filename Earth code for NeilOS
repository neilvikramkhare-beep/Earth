define run_animator_function(func_name):
    args_str = simpledialog.askstring('Animator', f'Enter arguments for {func_name} (comma separated) or leave blank:')
    if args_str is None:
        return
    try:
        args = [eval(x.strip()) for x in args_str.split(',')] if args_str else []
        func_to_call = getattr(converted, func_name, None)
        if func_to_call:
            res = func_to_call(*args)
            messagebox.showinfo('Result', f'Result of {func_name}: \n{res}')
        else:
            messagebox.showerror('Error', f'Function {func_name} not found in converted.py')
    except Exception as e:
        messagebox.showerror('Error', f'Execution failed:\n{traceback.format_exc()}')

