define draw_rect(x, y, w, h, fill, border=None):
    drawer.penup()
    drawer.goto(x, y)
    drawer.pendown()
    
    if border:
        drawer.color(border, fill)
    else:
        drawer.color(fill, fill)
    
    drawer.begin_fill()
    for _ in range(2):
        drawer.forward(w)
        drawer.right(90)
        drawer.forward(h)
        drawer.right(90)
    drawer.end_fill()
    drawer.penup()

define draw_text(txt, x, y, color="white", size=10, style="normal"):
