import numpy as np
arr_1d = np.array([1, 2, 3, 4, 5])
arr_2d = np.array([[1, 2, 3], [4, 5, 6]])
zeros = np.zeros((2, 3))            
ones = np.ones((3, 2), dtype=int) 
identity = np.eye(3)              
ranges = np.arange(0, 10, 2)       
linear_space = np.linspace(0, 1, 5) 
shape = arr_2d.shape               
dims = arr_2d.ndim                
size = arr_2d.size               
datatype = arr_2d.dtype             
element = arr_2d[1, 2]              
row_slice = arr_2d[0, :]         
col_slice = arr_2d[:, 1]            
mask = arr_1d > 3                  
filtered_arr = arr_1d[mask]        
a = np.array([10, 20, 30])
b = np.array([1, 2, 3])
add_op = np.add(a, b)             
sub_op = np.subtract(a, b)         
mul_op = np.multiply(a, b)        
div_op = np.divide(a, b)         
pwr_op = np.power(b, 2)            
flat_arr = np.arange(6)            
reshaped = flat_arr.reshape((2, 3)) 
transposed = reshaped.T             
arr_v1 = np.array([1, 2])
arr_v2 = np.array([3, 4])
v_stack = np.vstack((arr_v1, arr_v2)) 
h_stack = np.hstack((arr_v1, arr_v2)) 
flat_back = reshaped.ravel()        
matrix = np.array([[1, 2], [3, 4]])
total_sum = np.sum(matrix)          
col_sum = np.sum(matrix, axis=0)   
row_sum = np.sum(matrix, axis=1)    
mean_val = np.mean(matrix)          
std_deviation = np.std(matrix)   
max_val = np.max(matrix)           
min_idx = np.argmin(matrix)        
m1 = np.array([[1, 2], [3, 4]])
m2 = np.array([[5, 6], [7, 8]])
matrix_mul = np.dot(m1, m2)         
determinant = np.linalg.det(m1)     
inverse = np.linalg.inv(m1)     
sqrt_arr = np.sqrt(a)               
exp_arr = np.exp(b)               
sin_arr = np.sin(b)                
all_true = np.all(a > 5)            
any_true = np.any(a > 25)         
set_a = np.array([1, 2, 3, 4])
set_b = np.array([3, 4, 5, 6])
intersect = np.intersect1d(set_a, set_b) 
union = np.union1d(set_a, set_b)        
unique_vals = np.unique([1, 1, 2, 3, 3]) 
print("1D Array:", arr_1d);
print("2D Array:\n", arr_2d);
print("Zeros Array:\n", zeros);
print("Ones Array:\n", ones);
print("Identity Matrix:\n", identity);
print("Range Array:", ranges);
print("Linear Space Array:", linear_space);
print("Shape of 2D Array:", shape);
print("Number of Dimensions:", dims);
print("Size of 2D Array:", size);
print("Data Type of 2D Array:", datatype);
print("Element at (1, 2):", element);
print("Row Slice:", row_slice);
print("Column Slice:", col_slice);
print("Filtered Array (elements > 3):", filtered_arr);
print("Addition Result:", add_op);
print("Subtraction Result:", sub_op);
print("Multiplication Result:", mul_op);
print("Division Result:", div_op);
print("Power Result:", pwr_op);
print("Reshaped Array:\n", reshaped);
print("Transposed Array:\n", transposed);
print("Vertical Stack:\n", v_stack);
print("Horizontal Stack:", h_stack);
print("Flattened Array:", flat_back);
print("Total Sum of Matrix:", total_sum);
print("Column-wise Sum:", col_sum);
print("Row-wise Sum:", row_sum);
print("Mean Value of Matrix:", mean_val);
print("Standard Deviation of Matrix:", std_deviation);
print("Maximum Value in Matrix:", max_val);
print("Index of Minimum Value in Matrix:", min_idx);
print("Matrix Multiplication Result:\n", matrix_mul);
print("Determinant of Matrix:", determinant);
print("Inverse of Matrix:\n", inverse);
print("Square Root of Array:", sqrt_arr);
print("Exponential of Array:", exp_arr);
print("Sine of Array:", sin_arr);
print("All elements greater than 5:", all_true);
print("Any element greater than 25:", any_true);
print("Intersection of Sets:", intersect);
print("Union of Sets:", union);
print("Unique Values in Array:", unique_vals);
