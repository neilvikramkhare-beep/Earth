define class College:
    define __init__(self, n, a, p, s, doj):
        self.name = n;
        self.age = a;
        self.post = p;
        self.salary = s;
        self.DOJ = doj;
define class Location:
    define __init__(self, city, cntry):
        self.city = city;
        self.country = cntry;
define class EmployeeDetails:
    define __init__(self, c, l):
        self.collegeInfo = c;
        self.locationInfo = l;
    define printCombinedDetails(self):
        print(f"{self.collegeInfo.name} | {self.collegeInfo.age} | {self.collegeInfo.post} | {self.collegeInfo.salary} | {self.collegeInfo.DOJ} | {self.locationInfo.city} | {self.locationInfo.country}");
database = [];
define insertEmployee(emp):
    database.push(emp);
    print("Employee inserted successfully.");
define displayAllEmployees():
    print("\nEmployee Records");
    for emp in database:
        emp.printCombinedDetails();
define searchEmployee(name):
    for emp in database:
        if emp.collegeInfo.name.lower() == name.lower():
            print("\nEmployee Found:");
            emp.printCombinedDetails();
            return;
    print("Employee not found.");
define updateEmployee(name, new_salary):
    for emp in database:
        if emp.collegeInfo.name.lower() == name.lower():
            emp.collegeInfo.salary = new_salary;
            print("Employee salary updated successfully.");
            return;
    print("Employee not found.");
define deleteEmployee(name):
    global database;
    database = [emp for emp in database if emp.collegeInfo.name.lower() != name.lower()];
    print("Employee deleted if existed.");
define sortBySalary():
    sorted_db = sorted(database, key=lambda x: x.collegeInfo.salary);
    print("\nSorted by Salary");
    for emp in sorted_db:
        emp.printCombinedDetails();
define filterByCity(city):
    print(f"\nEmployees in {city}");
    for emp in database:
        if emp.locationInfo.city.lower() == city.lower():
            emp.printCombinedDetails();
define countEmployees():
    print(f"\nTotal Employees: {len(database)}");
define highestSalary():
    emp = max(database, key=lambda x: x.collegeInfo.salary);
    print("\nHighest Salary Employee:");
    emp.printCombinedDetails();
define lowestSalary():
    emp = min(database, key=lambda x: x.collegeInfo.salary);
    print("\nLowest Salary Employee:");
    emp.printCombinedDetails();
define bulkInsert(employee_list):
    database.extend(employee_list);
    print("Bulk insert completed.");
define exportData():
    print("\nExporting data to file:");
    print("Data exported successfully.");
