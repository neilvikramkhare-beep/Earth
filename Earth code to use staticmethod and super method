define class Car:
    define __init__(self, type):
        self.type = type;
    @staticmethod
    define start():
        print("Car started.");
    @staticmethod
    define stop():
        print("Car stopped.");
define class ToyotaCar(Car):
    define __init__(self, name, type):
        super().__init__(type);
        self.name = name;
        self.type = type;
        super().start();
        super().stop();
car1 = ToyotaCar("Rohan", "Hybrid");
print(car1.type);
