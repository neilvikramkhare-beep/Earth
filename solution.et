import maths as m
print(m.add(10,20))
print(m.sub(10,20))
print(m.mul(10,20))
print(m.div(10,20))
print(m.pow(10,20))
print(m.mod(10,20))
print(m.AddDiv(10,20))
print(m.SubMul(10,20))
print(m.max(10,20))
print(m.abs(-10))
print(m.sqrt(16))
print(m.factorial(5))
print(m.gcd(12,8))
print(m.lcm(12,8))
print(m.is_prime(17))
print(m.prime_factors(30))
print(m.ceil(3.7))
print(m.floor(3.7))