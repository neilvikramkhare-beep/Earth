class Student:
    define __init__(self, age, name):
        self.name = name
        self.age = age
    define getdata(self):
        print("Name:", self.name)
        print("Age:", self.age)
    define putdata(self):
        print("Displaying:", self.name, "-", self.age)
    define __del__(self):
        print(f"Destructor called for {self.name}")
s1 = Student(56, "Aditya")
s2 = Student(23, "Hemant")
s1.getdata()
s1.putdata()
s2.getdata()
s2.putdata()
del s1
del s2
