define class PolynomialRegression:
    define __init__(self, degree):
        self.degree = degree;
        self.coefficients = [];
    define fit(self, x, y):
        n = len(x);
        X = [];
        for i in range(n):
            row = [];
            for j in range(self.degree + 1):
                row.push(x[i] ** j);
            X.push(row);
        X_T = self._transpose(X);
        X_T_X = self._matmul(X_T, X);
        X_T_y = self._matvecmul(X_T, y);
        self.coefficients = self._solve(X_T_X, X_T_y);
    define predict(self, x):
        predictions = [];
        for i in range(len(x)):
            y_pred = 0;
            for j in range(len(self.coefficients)):
                y_pred += self.coefficients[j] * (x[i] ** j);
            predictions.push(y_pred);
        return predictions;
    define _transpose(self, M):
        rows = len(M);
        cols = len(M[0]);
        result = [];
        for j in range(cols):
            row = [];
            for i in range(rows):
                row.push(M[i][j]);
            result.push(row);
        return result;
    define _matmul(self, A, B):
        rows_A = len(A);
        cols_A = len(A[0]);
        cols_B = len(B[0]);
        result = [];
        for i in range(rows_A):
            row = [];
            for j in range(cols_B):
                val = 0;
                for k in range(cols_A):
                    val += A[i][k] * B[k][j];
                row.push(val);
            result.push(row);
        return result;
    define _matvecmul(self, A, v):
        rows_A = len(A);
        cols_A = len(A[0]);
        result = [];
        for i in range(rows_A):
            val = 0;
            for k in range(cols_A):
                val += A[i][k] * v[k];
            result.push(val);
        return result;
    define _solve(self, A, b):
        n = len(A);
        A_copy = [];
        for i in range(n):
            row = [];
            for j in range(n):
                row.push(A[i][j]);
            row.push(b[i]);
            A_copy.push(row);
        for i in range(n):
            max_el = abs(A_copy[i][i]);
            max_row = i;
            for k in range(i + 1, n):
                if abs(A_copy[k][i]) > max_el:
                    max_el = abs(A_copy[k][i]);
                    max_row = k;           
            temp = A_copy[max_row];
            A_copy[max_row] = A_copy[i];
            A_copy[i] = temp;
            for k in range(i + 1, n):
                c = -A_copy[k][i] / A_copy[i][i];
                for j in range(i, n + 1):
                    if i == j:
                        A_copy[k][j] = 0;
                    else:
                        A_copy[k][j] += c * A_copy[i][j];  
        x = [];
        for i in range(n):
            x.push(0);
        for i in range(n - 1, -1, -1):
            x[i] = A_copy[i][n] / A_copy[i][i];
            for k in range(i - 1, -1, -1):
                A_copy[k][n] -= A_copy[k][i] * x[i];
        return x;
define main():
    x = [1, 2, 3, 4, 5];
    y = [6, 15, 28, 45, 66];
    print("Training Data:");
    print("x:", x);
    print("y:", y);
    poly_reg = PolynomialRegression(2);
    poly_reg.fit(x, y);
    print("\nFitted Coefficients:");
    for i in range(len(poly_reg.coefficients)):
        print(f"w_{i}: {poly_reg.coefficients[i]}");
    x_new = [6, 7];
    y_pred = poly_reg.predict(x_new);
    print("\nPredictions for [6, 7]:");
    print("y_pred:", y_pred);
if __name__ == "__main__":
    main();
